    "bench": "playwright test tests/benchmark.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "vite": "^6",
    "vite-plugin-top-level-await": "^1",
    "vite-plugin-wasm": "^3"
  }
}

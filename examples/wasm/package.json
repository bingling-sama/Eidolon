{
  "name": "eidolon-wasm-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build --target bundler --out-dir examples/wasm/pkg ../.. -- --features wasm",
    "build:wasm:dev": "wasm-pack build --dev --target bundler --out-dir examples/wasm/pkg ../.. -- --features wasm",
    "dev": "vite",
